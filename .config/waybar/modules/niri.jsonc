{
  "niri/workspaces": {
    "all-outputs": true,
    "format": "{}",
    /*"format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    },*/
    "sort-by-number": true,
    "active-only": true,
    "justify": "center"
  },

"niri/window": {
      "format": "<span  weight='bold' >{class}</span>",
      "max-length": 15,
      "icon": true,
      "icon-size": 14
    }
}
